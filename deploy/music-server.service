[Unit]
Description=Music server
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=music-server
Group=music-server
ExecStart=/usr/local/bin/music-server -config /etc/music-server/music-server.conf
Restart=on-failure
RestartSec=5s
StateDirectory=music-server
WorkingDirectory=/var/lib/music-server
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/music-server

[Install]
WantedBy=multi-user.target
